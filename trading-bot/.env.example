# Copy to .env (never commit it). Keys from IG: My IG > Settings > API keys, on the DEMO account.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
# Market (epic) from IG, e.g. Germany 40 mini: IX.D.DAX.IFMM.IP
BOT_EPIC=IX.D.DAX.IFMM.IP
BOT_RESOLUTION=MINUTE_5
BOT_SIZE=1
# Stop opening trades after this loss in the account currency, per day
BOT_MAX_DAILY_LOSS=100
BOT_POLL_MS=5000
