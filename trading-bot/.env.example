# Copy to .env (never commit it). Keys from IG: My IG > Settings > API keys, on the DEMO account.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=

# Market (epic) from IG. Germany 40 "mini" (1 EUR per point): IX.D.DAX.IFMM.IP
BOT_EPIC=IX.D.DAX.IFMM.IP
# orb = opening range breakout (default), ema = the original EMA cross
BOT_STRATEGY=orb
# Contracts per trade. On the mini DAX, 1 = 1 EUR per point.
BOT_SIZE=1
# Stop opening trades and close positions after this loss in the account currency, per day
BOT_MAX_DAILY_LOSS=100
BOT_POLL_MS=5000

# Opening range breakout settings (from the research): range of the first 15 minutes
# after 09:00, stop at the other side of the range, target 2x the risk, flat at 17:30.
ORB_RANGE_MIN=15
ORB_TARGET_R=2
ORB_STOP_FRAC=1
