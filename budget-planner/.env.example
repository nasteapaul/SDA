# Copy to .env and fill in. Never commit .env or your private key.

# Password for the app (required to open it to your phone on the home Wi-Fi).
APP_PASSWORD=change-me-to-something-long

# Port the app listens on.
PORT=8080

# The address you open the app at. Used to build the bank redirect URL.
# Use your server's fixed LAN IP (set a DHCP reservation in your router),
# or your Tailscale HTTPS name — see README.
PUBLIC_URL=http://192.168.1.50:8080

# --- Bank sync (Enable Banking, free for your own accounts) ---
EB_APP_ID=
EB_PRIVATE_KEY_PATH=./enablebanking.pem
# Optional: override the redirect URL registered in the Enable Banking control panel.
# EB_REDIRECT_URL=http://192.168.1.50:8080/bank/callback

# How often the server pulls new transactions (PSD2 allows ~4 background pulls/day).
SYNC_INTERVAL_HOURS=6
# Opening the app triggers a sync if the last one is older than this.
AUTO_SYNC_MIN_MINUTES=120

# Optional HTTPS (needed for offline mode / service worker on phones over the LAN).
# TLS_CERT=./certs/budget.crt
# TLS_KEY=./certs/budget.key
