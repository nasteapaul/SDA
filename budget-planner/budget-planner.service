# systemd unit — keeps the budget server running on a Raspberry Pi / home PC.
#   sudo cp budget-planner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now budget-planner
#   journalctl -u budget-planner -f      # logs
[Unit]
Description=Budget Planner (RON) with bank sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/budget-planner
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pi/budget-planner/data
# Only the app folder is visible; nothing else in /home.
ProtectHome=tmpfs
BindPaths=/home/pi/budget-planner
PrivateTmp=true
PrivateDevices=true
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
